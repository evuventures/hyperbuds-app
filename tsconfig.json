{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/profile/complete-profile/page.jsx",
    "src/components/profile/ProfileCard.jsx",
    "src/app/profile/page.jsx",
    "src/types/jest-dom.d.ts",
    ".next/dev/types/**/*.ts",
    ".next.nosync/types/**/*.ts",
    ".next.nosync/dev/types/**/*.ts",
    ".next-pw.nosync/types/**/*.ts",
    ".next-pw.nosync/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "node_modules/**",
    "node_modules.nosync",
    "node_modules.nosync/**",
    "**/node_modules.nosync/**",
    ".old_nm.nosync",
    ".old_nm.nosync/**"
  ]
}

